{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "gitleaks",
          "rules": [
            {
              "id": "aws-access-token",
              "shortDescription": { "text": "AWS Access Token" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "aws-access-token",
          "level": "error",
          "message": { "text": "Identified a AWS Access Key, risking unauthorized access." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "config.py" },
                "region": { "startLine": 3, "endLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
