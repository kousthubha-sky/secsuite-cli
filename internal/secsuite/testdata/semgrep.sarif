{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "rules": [
            {
              "id": "javascript.lang.security.audit.sqli.sqli-injection",
              "shortDescription": { "text": "Possible SQL injection" },
              "fullDescription": { "text": "User input concatenated into SQL query." },
              "helpUri": "https://semgrep.dev/r/javascript.lang.security.audit.sqli",
              "properties": { "tags": ["security", "sqli"] },
              "defaultConfiguration": { "level": "error" }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "javascript.lang.security.audit.sqli.sqli-injection",
          "message": { "text": "Possible SQL injection via string concatenation." },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "app.js" },
                "region": { "startLine": 5, "endLine": 5 }
              }
            }
          ]
        }
      ]
    }
  ]
}
