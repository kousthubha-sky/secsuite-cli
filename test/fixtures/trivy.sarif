{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Trivy",
          "rules": [
            {
              "id": "CVE-2020-8203",
              "shortDescription": { "text": "lodash: prototype pollution" },
              "fullDescription": { "text": "lodash versions before 4.17.19 are vulnerable to prototype pollution." },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2020-8203",
              "properties": { "tags": ["vulnerability", "security", "HIGH"] }
            },
            {
              "id": "aws-access-key-id",
              "shortDescription": { "text": "AWS Access Key ID" },
              "fullDescription": { "text": "Hardcoded AWS Access Key ID detected." },
              "properties": { "tags": ["secret", "security", "HIGH"] }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "CVE-2020-8203",
          "level": "error",
          "message": { "text": "Package lodash@4.17.4: prototype pollution (CVE-2020-8203)" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "package.json" },
                "region": { "startLine": 7, "endLine": 7 }
              }
            }
          ]
        },
        {
          "ruleId": "aws-access-key-id",
          "level": "error",
          "message": { "text": "AWS Access Key ID exposed in config.py" },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": { "uri": "config.py" },
                "region": { "startLine": 3, "endLine": 3 }
              }
            }
          ]
        }
      ]
    }
  ]
}
